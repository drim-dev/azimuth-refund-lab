#!/bin/sh
set -eu

SYSTEM_TEST_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SYSTEM_TEST_ROOT/../.." && pwd)

cleanup() {
  if [ "${KEEP_REFUND_LAB_STACK:-0}" != "1" ]; then
    docker compose --project-directory "$PROJECT_ROOT" down --volumes --remove-orphans
  fi
}
trap cleanup EXIT INT TERM

docker compose --project-directory "$PROJECT_ROOT" down --volumes --remove-orphans
docker compose --project-directory "$PROJECT_ROOT" up --detach --build
"$PROJECT_ROOT/scripts/demo-doctor"

cd "$SYSTEM_TEST_ROOT"
npx playwright test
