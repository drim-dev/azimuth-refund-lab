#!/bin/sh
set -eu

TOOL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$TOOL_DIR/../.." && pwd)
LINKAGE=${1:-"$REPO_ROOT/.azimuth/linkage.json"}
WORKER="$REPO_ROOT/services/refund-worker"
REPORT="$WORKER/target/pit-reports/mutations.xml"
SELECTION="$TOOL_DIR/pit-selection.json"
OBSERVATION="$TOOL_DIR/worker-idempotency-observation.json"
AZIMUTH_SOURCE=${AZIMUTH_SOURCE_DIR:-"$REPO_ROOT/.cache/azimuth"}
UPSTREAM="$AZIMUTH_SOURCE/tools/extractors/typescript"
PIT_VERSION=1.22.0

if [ ! -s "$REPORT" ]; then
  echo "pit-challenge: PIT produced no mutations.xml at $REPORT" >&2
  exit 2
fi
if [ ! -f "$UPSTREAM/dist/pit-cli.js" ]; then
  echo "pit-challenge: build a PIT-capable Azimuth TypeScript extractor first" >&2
  echo "pit-challenge: use AZIMUTH_SOURCE_DIR for framework development before the pin advances" >&2
  exit 2
fi

node "$UPSTREAM/dist/pit-cli.js" \
  "$REPORT" \
  "$LINKAGE" \
  "$OBSERVATION" \
  --root "$REPO_ROOT" \
  --config "$WORKER/pom.xml" \
  --selection "$SELECTION" \
  --tool-version "$PIT_VERSION"

node "$TOOL_DIR/require-clean.mjs" "$OBSERVATION"
