#!/bin/sh
set -eu

TOOL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$TOOL_DIR/../.." && pwd)
LINKAGE=${1:-"$REPO_ROOT/.azimuth/linkage.json"}
WORKER="$REPO_ROOT/services/refund-worker"
SELECTION="$TOOL_DIR/pit-selection.json"
PIT_VERSION=1.22.0

node "$TOOL_DIR/derive-selection.mjs" "$LINKAGE" "$SELECTION"
"$REPO_ROOT/mvnw" -B -f "$WORKER/pom.xml" test-compile org.pitest:pitest-maven:$PIT_VERSION:mutationCoverage

"$TOOL_DIR/import" "$LINKAGE"
