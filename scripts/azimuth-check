#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
AZIMUTH="$PROJECT_ROOT/.cache/azimuth-tools/bin/azimuth"
ACCOUNTS="$PROJECT_ROOT/demo/teaching/fixtures/stage-accounts.tsv"
SELECTED_STAGE="${TMPDIR:-/tmp}/azimuth-refund-lab-teaching-stage"
cd "$PROJECT_ROOT"

usage() {
  echo "usage: scripts/azimuth-check [--fixture <stage>] [--pre-review]" >&2
  exit 2
}

account_line() {
  awk -F '|' -v wanted="$1" '$1 == wanted { print; found = 1 } END { exit !found }' \
    "$ACCOUNTS"
}

run_account() {
  stage=$1
  phase=$2
  line=$(account_line "$stage") || {
    echo "unknown teaching stage: $stage" >&2
    exit 2
  }
  model=$(printf '%s\n' "$line" | cut -d '|' -f 2)
  pre_review_model=$(printf '%s\n' "$line" | cut -d '|' -f 3)
  standards=$(printf '%s\n' "$line" | cut -d '|' -f 4)
  manifests=$(printf '%s\n' "$line" | cut -d '|' -f 5)

  if [ "$phase" = "pre-review" ]; then
    if [ "$pre_review_model" = "-" ]; then
      echo "selected account has no separate pre-review state: $stage" >&2
      exit 2
    fi
    model=$pre_review_model
  fi

  set -- "$AZIMUTH" check
  if [ "$model" != "-" ]; then
    set -- "$@" --model "$PROJECT_ROOT/$model" --standards "$PROJECT_ROOT/$standards"
  fi

  previous_ifs=$IFS
  IFS=,
  for manifest in $manifests; do
    set -- "$@" --manifest "$PROJECT_ROOT/$manifest"
  done
  IFS=$previous_ifs
  "$@"
}

if [ ! -x "$AZIMUTH" ]; then
  "$PROJECT_ROOT/scripts/bootstrap-azimuth"
fi

phase=reviewed
case "$#" in
  0)
    if [ -f "$SELECTED_STAGE" ]; then
      stage=$(sed -n '1p' "$SELECTED_STAGE")
    else
      stage=final-account
    fi
    ;;
  1)
    [ "$1" = "--pre-review" ] || usage
    phase=pre-review
    if [ -f "$SELECTED_STAGE" ]; then
      stage=$(sed -n '1p' "$SELECTED_STAGE")
    else
      echo "no teaching stage selected; run scripts/demo-stage first" >&2
      exit 2
    fi
    ;;
  2)
    [ "$1" = "--fixture" ] || usage
    stage=$2
    ;;
  *) usage ;;
esac

run_account "$stage" "$phase"
