#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
STAGES="$PROJECT_ROOT/demo/teaching/stages.tsv"
HISTORY="$PROJECT_ROOT/demo/teaching/accounts/judgment-history.tsv"
SELECTED_STAGE="${TMPDIR:-/tmp}/azimuth-refund-lab-teaching-stage"
cd "$PROJECT_ROOT"

if [ "$#" -gt 1 ]; then
  echo "usage: scripts/show-judgment-history [historical-claim-or-lineage]" >&2
  exit 2
fi

claim=${1:-provider-refund-applied-once}
if [ -f "$SELECTED_STAGE" ]; then
  selected=$(sed -n '1p' "$SELECTED_STAGE")
else
  selected=final-account
fi

echo "Judgment history visible at stage: $selected"
echo "Requested historical identity or lineage: $claim"
awk -F '|' -v wanted="$claim" -v selected="$selected" '
  FNR == NR {
    if ($0 !~ /^#/ && NF == 6) order[$1] = ++last
    next
  }
  /^#/ { next }
  ($3 == wanted || $4 == wanted) && order[$2] <= order[selected] {
    printf "%s. %-16s [%-26s; %-20s] claim: %s\n", $1, $5, $6, $7, $4
    print "   " $8
    found = 1
  }
  END { if (!found) exit 1 }
' "$STAGES" "$HISTORY" || {
  echo "unknown teaching claim or no judgment visible at this stage: $claim" >&2
  exit 2
}

echo
echo "Constructed corrections preserve the false positive; they do not rewrite it."
if [ "$selected" = "final-account" ]; then
  echo "The final row names the current production claim and authentic current-account provenance."
fi
