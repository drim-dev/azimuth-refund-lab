#!/bin/sh
set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
STAGES="$PROJECT_ROOT/demo/teaching/stages.tsv"
ACCOUNTS="$PROJECT_ROOT/demo/teaching/fixtures/stage-accounts.tsv"
cd "$PROJECT_ROOT"

usage() {
  echo "usage: scripts/demo-stage list" >&2
  echo "       scripts/demo-stage show <stage>" >&2
  echo "       scripts/demo-stage replay <stage>" >&2
  echo "       scripts/demo-stage checkout <stage>" >&2
  echo "       scripts/demo-stage <stage-or-demo-alias>" >&2
  exit 2
}

stage_line() {
  awk -F '|' -v wanted="$1" '$1 == wanted { print; found = 1 } END { exit !found }' "$STAGES"
}

stage_field() {
  stage_line "$1" | cut -d '|' -f "$2"
}

list_stages() {
  awk -F '|' '
    /^#/ { next }
    NF == 6 {
      printf "%-20s %-21s %-21s %s\n", $1, $3, $4, $6
    }
  ' "$STAGES"
}

show_stage() {
  line=$(stage_line "$1") || {
    echo "unknown teaching stage: $1" >&2
    exit 2
  }
  echo "$line" | awk -F '|' '{
    print "stage:            " $1
    print "future tag:       " $2
    print "provenance:       " $3
    print "machine result:   " $4
    print "agent result:     " $5
    print "purpose:          " $6
  }'
  tag=$(stage_field "$1" 2)
  if git -C "$PROJECT_ROOT" rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
    echo "tag materialized: yes"
  else
    echo "tag materialized: no"
  fi
}

replay_stage() {
  kind=$(stage_field "$1" 3) || {
    echo "unknown teaching stage: $1" >&2
    exit 2
  }
  echo "Replaying $1 ($kind; no checkout)"
  printf '%s\n' "$1" > "${TMPDIR:-/tmp}/azimuth-refund-lab-teaching-stage"
  check_status=0
  "$PROJECT_ROOT/scripts/azimuth-check" --fixture "$1" || check_status=$?
  echo "Raw Azimuth exit: $check_status"

  case "$1" in
    dishonest-green|weak-oracle|stale-judgment)
      sed -n '1,220p' "$PROJECT_ROOT/demo/teaching/accounts/$1.md"
      ;;
    surviving-mutant)
      "$PROJECT_ROOT/scripts/pit-replay" --teaching-weak
      sed -n '1,220p' "$PROJECT_ROOT/demo/teaching/accounts/surviving-mutant.md"
      ;;
    final-account)
      "$PROJECT_ROOT/scripts/pit-replay" --teaching-strong
      judgment=$("$PROJECT_ROOT/.cache/azimuth-tools/bin/azimuth" judge \
        --manifest "$PROJECT_ROOT/.azimuth/linkage.json" \
        --manifest "$PROJECT_ROOT/tooling/pit/worker-idempotency-observation.json")
      printf '%s\n' "$judgment" | awk 'substr($0, 1, 1) != "\t" { print }'
      if ! printf '%s\n' "$judgment" | grep -F "judged sound" >/dev/null; then
        echo "the authentic final judgment is no longer current and sound" >&2
        exit 1
      fi
      ;;
  esac
  return "$check_status"
}

select_stage() {
  stage_line "$1" >/dev/null || {
    echo "unknown teaching stage: $1" >&2
    exit 2
  }
  printf '%s\n' "$1" > "${TMPDIR:-/tmp}/azimuth-refund-lab-teaching-stage"
  echo "Selected teaching stage: $1"
  model=$(awk -F '|' -v wanted="$1" '$1 == wanted { print $2 }' "$ACCOUNTS")
  echo "Selected offline account model: $model"
  echo "The current azimuth/model tree remains the authentic final account."
  echo "The immutable tag is not required for offline replay; the next cue reads this selection."
}

checkout_stage() {
  tag=$(stage_field "$1" 2) || {
    echo "unknown teaching stage: $1" >&2
    exit 2
  }
  if ! git -C "$PROJECT_ROOT" rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
    echo "refusing checkout: immutable tag $tag has not been materialized" >&2
    echo "use 'scripts/demo-stage replay $1' for the offline fixture" >&2
    exit 1
  fi
  if [ -n "$(git -C "$PROJECT_ROOT" status --porcelain)" ]; then
    echo "refusing checkout: the worktree is not clean" >&2
    exit 1
  fi
  git -C "$PROJECT_ROOT" switch --detach "$tag"
}

[ "$#" -ge 1 ] || usage

if [ "$#" -eq 1 ]; then
  case "$1" in
    demo-01-uncovered) select_stage missing-cover; exit ;;
    demo-02-wrong-form) select_stage wrong-evidence-form; exit ;;
    demo-03-dishonest-binding) select_stage dishonest-green; exit ;;
    demo-04-weak-oracle) select_stage weak-oracle; exit ;;
    demo-05-surviving-mutant) select_stage surviving-mutant; exit ;;
    demo-06-stale-judgment) select_stage stale-judgment; exit ;;
    demo-07-provider-idempotency) select_stage final-account; exit ;;
  esac
fi

case "$1" in
  list)
    [ "$#" -eq 1 ] || usage
    list_stages
    ;;
  show)
    [ "$#" -eq 2 ] || usage
    show_stage "$2"
    ;;
  replay)
    [ "$#" -eq 2 ] || usage
    replay_stage "$2"
    ;;
  checkout)
    [ "$#" -eq 2 ] || usage
    checkout_stage "$2"
    ;;
  *)
    usage
    ;;
esac
